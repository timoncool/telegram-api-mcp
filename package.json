{
  "name": "telegram-api-mcp",
  "version": "0.2.0",
  "description": "Telegram Bot API 10.3 MCP server — 185 methods, complete parameter registry and schema-driven file uploads",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "telegram-api-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:refresh": "node scripts/refresh-docs.mjs",
    "audit": "npm run build && node scripts/audit-registry.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "audit:live": "npm run build && node scripts/audit-registry.mjs --live",
    "check": "npm run typecheck && npm run lint && npm test && npm run audit"
  },
  "keywords": [
    "telegram",
    "bot-api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent"
  ],
  "author": "timoncool",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json",
    "smithery.yaml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/timoncool/telegram-api-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
